RewriteEngine On

# Disable MultiViews
Options -MultiViews

# Default page
DirectoryIndex index.php

# Disable directory listing
Options -Indexes

# Exclude admin directory, uploads, and PHPMailer from all rewrite rules
RewriteRule ^(admin|uploads|PHPMailer)(/.*)?$ - [L,NC]
RewriteCond %{REQUEST_URI} (admin|uploads|PHPMailer) [NC]
RewriteRule ^ - [L]

# Never redirect or rewrite POST requests (prevents losing form data)
RewriteCond %{REQUEST_METHOD} POST
RewriteRule ^ - [L]

# Redirect direct .php URLs to clean URLs (only for GET requests and frontend)
RewriteCond %{REQUEST_METHOD} !POST
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
RewriteCond %{REQUEST_URI} !(admin|uploads|PHPMailer) [NC]
RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^(.+)\.php$ /$1 [R=301,L,NE]

# Internally load .php file for clean URL
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L]

# Protect .htaccess
<Files ".htaccess">
    Require all denied
</Files>